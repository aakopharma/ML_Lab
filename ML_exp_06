Practical 6: Naive Bayesian Classifier
Aim: Implement a Naive Bayes classifier using a CSV training dataset and calculate its accuracy on test data.

Dataset: Wine recognition dataset built into Scikit-learn. It contains 13 numerical features and three wine classes.
Complete Python program


import pandas as pd
from sklearn.datasets import load_wine
from sklearn.model_selection import train_test_split
from sklearn.naive_bayes import GaussianNB
from sklearn.metrics import accuracy_score, confusion_matrix

# Load the real Wine dataset
wine = load_wine(as_frame=True)

data = wine.data.copy()
data["Class"] = wine.target

# Save the dataset as CSV
data.to_csv("naive_bayes_data.csv", index=False)

# Read the CSV file
data = pd.read_csv("naive_bayes_data.csv")

X = data.drop(columns=["Class"])
y = data["Class"]

# Split the dataset
X_train, X_test, y_train, y_test = train_test_split(
    X, y,
    test_size=0.25,
    random_state=42,
    stratify=y
)

# Create and train Gaussian Naive Bayes
model = GaussianNB()
model.fit(X_train, y_train)

# Predict test samples
predictions = model.predict(X_test)

# Calculate accuracy
accuracy = accuracy_score(y_test, predictions)

print("Predictions:", predictions)
print("Actual Values:", y_test.to_numpy())
print("Accuracy:", accuracy)
print("Accuracy Percentage:", round(accuracy * 100, 2), "%")

print("\nConfusion Matrix:")
print(confusion_matrix(y_test, predictions))

# Predict a few new samples
test_data = X_test.iloc[:3]
test_predictions = model.predict(test_data)

print("\nNew Test Data Predictions:")
for i, prediction in enumerate(test_predictions):
    print(
        "Sample", i + 1,
        "Predicted Class:", wine.target_names[prediction]
    )



